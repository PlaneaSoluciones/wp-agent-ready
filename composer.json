{
	"name": "planeasoluciones/wp-agent-ready",
	"description": "WordPress plugin that exposes published content to AI agents and LLMs via a clean REST API",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Planea Soluciones",
			"email": "info@planeasoluciones.com",
			"homepage": "https://planeasoluciones.com"
		}
	],
	"require": {
		"php": ">=8.2,<8.6",
		"yahnis-elsts/plugin-update-checker": "^6.0,<7.0"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": ">=3.13.6,<4.0.0",
		"wp-coding-standards/wpcs": ">=3.4.1,<4.0.0",
		"dealerdirect/phpcodesniffer-composer-installer": ">=1.2.1,<2.0.0",
		"phpstan/phpstan": ">=2.3.7,<3.0.0",
		"szepeviktor/phpstan-wordpress": ">=2.0.4,<3.0.0"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=768M",
		"check": [
			"@lint",
			"@analyse"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
